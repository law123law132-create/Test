import os
import json
import subprocess
from datetime import datetime

CONFIG_FILE = "config.json"
LOG_DIR = "logs"
LOG_FILE = os.path.join(LOG_DIR, "launcher.log")


DEFAULT_CONFIG = {
    "animal_company_path": "",
    "steamvr_path": ""
}


# -----------------------------
# Setup
# -----------------------------

def setup():
    os.makedirs(LOG_DIR, exist_ok=True)

    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w") as f:
            json.dump(DEFAULT_CONFIG, f, indent=4)

    if not os.path.exists(LOG_FILE):
        open(LOG_FILE, "w").close()


def load_config():
    try:
        with open(CONFIG_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG.copy()


def save_config(config):
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=4)


# -----------------------------
# Logging
# -----------------------------

def log(message):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(f"[{timestamp}] {message}\n")


def info(message):
    print(f"\033[96m[INFO]\033[0m {message}")
    log(f"INFO: {message}")


def success(message):
    print(f"\033[92m[OK]\033[0m {message}")
    log(f"OK: {message}")


def error(message):
    print(f"\033[91m[ERROR]\033[0m {message}")
    log(f"ERROR: {message}")


# -----------------------------
# Launching
# -----------------------------

def launch_program(path, name):
    if not path:
        error(f"{name} path has not been configured.")
        return

    if not os.path.exists(path):
        error(f"{name} executable was not found:")
        print(path)
        return

    try:
        subprocess.Popen([path])
        success(f"{name} launched.")
    except Exception as e:
        error(f"Could not launch {name}: {e}")


def launch_animal_company():
    config = load_config()
    launch_program(
        config["animal_company_path"],
        "Animal Company"
    )


def launch_steamvr():
    config = load_config()
    launch_program(
        config["steamvr_path"],
        "SteamVR"
    )


# -----------------------------
# Status
# -----------------------------

def check_status():
    print("\n--- STATUS ---")

    processes = [
        "AnimalCompany.exe",
        "vrserver.exe",
        "vrmonitor.exe"
    ]

    try:
        result = subprocess.check_output(
            ["tasklist"],
            text=True,
            errors="ignore"
        )

        for process in processes:
            if process.lower() in result.lower():
                print(f"\033[92m[RUNNING]\033[0m {process}")
            else:
                print(f"\033[90m[OFFLINE]\033[0m  {process}")

    except Exception as e:
        error(f"Unable to check processes: {e}")

    input("\nPress Enter to continue...")


# -----------------------------
# Logs
# -----------------------------

def view_logs():
    os.system("cls")

    print("=" * 60)
    print("                         LOGS")
    print("=" * 60)

    try:
        with open(LOG_FILE, "r", encoding="utf-8") as f:
            lines = f.readlines()

        if not lines:
            print("\nNo logs yet.")
        else:
            for line in lines[-30:]:
                print(line.rstrip())

    except Exception as e:
        error(str(e))

    input("\nPress Enter to continue...")


def clear_logs():
    with open(LOG_FILE, "w") as f:
        f.write("")

    success("Logs cleared.")
    input("\nPress Enter to continue...")


# -----------------------------
# Settings
# -----------------------------

def settings():
    config = load_config()

    while True:
        os.system("cls")

        print("=" * 60)
        print("                       SETTINGS")
        print("=" * 60)

        print(f"\n1. Animal Company path")
        print(f"   {config['animal_company_path'] or '[NOT SET]'}")

        print(f"\n2. SteamVR path")
        print(f"   {config['steamvr_path'] or '[NOT SET]'}")

        print("\n3. Save")
        print("4. Back")

        choice = input("\nChoose an option: ").strip()

        if choice == "1":
            path = input("\nEnter Animal Company .exe path:\n> ").strip()
            config["animal_company_path"] = path

        elif choice == "2":
            path = input("\nEnter SteamVR .exe path:\n> ").strip()
            config["steamvr_path"] = path

        elif choice == "3":
            save_config(config)
            success("Settings saved.")
            input("\nPress Enter...")

        elif choice == "4":
            break


